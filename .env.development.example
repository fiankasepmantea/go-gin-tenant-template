# DEVELOPMENT MODE (local). Copy to .env.development, or run: make env-init
# .env.development must not be committed (it is already in .gitignore).

APP_ENV=development
APP_PORT=8080
# debug = most verbose logging, text format so it is easy to read in a terminal
LOG_LEVEL=debug

# Matches the Postgres started by: make docker-up
DB_HOST=localhost
DB_PORT=5432
# Host ports for docker compose. Change them if another container/project already uses the port.
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
KAFKA_PORT=9092
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=tenantdb
DB_SCHEMA=public
DB_SSLMODE=disable

# Filled in automatically by make env-init. Manually: make keygen
PASETO_KEY=
TOKEN_ISSUER=go-gin-tenant-template
# Tokens live longer in development so you do not have to log in again often
ACCESS_TOKEN_TTL=1h
REFRESH_TOKEN_TTL=720h

# Rate limiting of login/password reset. Without REDIS_ADDR the counters live in the memory of the process.
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
RATE_LIMIT_ATTEMPTS=5
RATE_LIMIT_WINDOW=15m

# Password reset e-mail. Without SMTP_HOST the message is written to the log, including the reset link
# (development only). To read real messages locally run: make docker-up PROFILES="mail"
# and open http://localhost:8025, then set SMTP_HOST=localhost, SMTP_PORT=1025, SMTP_SECURITY=none.
APP_NAME=go-gin-tenant-template
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@localhost
SMTP_SECURITY=starttls
PASSWORD_RESET_TTL=30m
# Page of your front end that takes the token. Placeholders: {token} and {tenant}.
PASSWORD_RESET_URL=

# gRPC AuthService (make run-grpc). Other services call it to verify tokens and ask "may this user call this endpoint?".
# Plain (no TLS) is fine locally. See docs/grpc.md.
GRPC_ADDR=:9090
GRPC_TLS_CERT_FILE=
GRPC_TLS_KEY_FILE=
GRPC_TLS_CLIENT_CA_FILE=

# How the tenant is identified at login. Leave TENANT_BASE_DOMAIN empty if you do not use subdomains.
TENANT_BASE_DOMAIN=
TENANT_HEADER=X-Tenant-Code
