# PRODUCTION MODE. This template contains NO secret values.
#
# On servers/Kubernetes, supply these values through a ConfigMap + Secret or a secret manager,
# NOT through a file. .env.production is only for non-container deployments and must not be committed.
# Use a PASETO_KEY and DB_PASSWORD that are DIFFERENT from development.

APP_ENV=production
APP_PORT=8080
LOG_LEVEL=info

DB_HOST=
DB_PORT=5432
DB_USER=
# REQUIRED in production (the application refuses to start if empty)
DB_PASSWORD=
DB_NAME=
DB_SCHEMA=public
# require or verify-full. "disable" is rejected in production.
DB_SSLMODE=require

# REQUIRED. Generate with: make keygen
PASETO_KEY=
TOKEN_ISSUER=go-gin-tenant-template
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Rate limiting. REQUIRED with more than one replica (without Redis every replica counts on its own).
REDIS_ADDR=
# secret: from the secret manager, not from a file in the repository
REDIS_PASSWORD=
RATE_LIMIT_ATTEMPTS=5
RATE_LIMIT_WINDOW=15m

# Password reset e-mail. Without SMTP_HOST reset e-mails cannot be delivered (the endpoint still answers 202).
APP_NAME=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
# secret
SMTP_PASSWORD=
SMTP_FROM=
# starttls or tls ("none" is rejected in production)
SMTP_SECURITY=starttls
PASSWORD_RESET_TTL=30m
# https only in production. Placeholders: {token} and {tenant}.
PASSWORD_RESET_URL=

# gRPC AuthService (cmd/grpc). TLS is required in production: set the certificate and key, and the client CA so that
# only your own services can call it (mutual TLS). Behind a service mesh that already does mTLS you may set
# GRPC_ALLOW_PLAINTEXT=true instead. The files come from the secret manager / a mounted secret, not from the repository.
GRPC_ADDR=:9090
GRPC_TLS_CERT_FILE=
GRPC_TLS_KEY_FILE=
GRPC_TLS_CLIENT_CA_FILE=
GRPC_ALLOW_PLAINTEXT=false

# Example: app.example.com  -> tokoa.app.example.com is recognized as tenant "tokoa"
TENANT_BASE_DOMAIN=
TENANT_HEADER=X-Tenant-Code

# OpenAPI / Swagger UI (docs/openapi.md): off unless you set it and protect the route in front of the server.
# DOCS_ENABLED=true

# Prometheus metrics (docs/observability.md): off unless you set both. The token comes from the secret manager.
# METRICS_ENABLED=true
# METRICS_TOKEN=
# Dedicated database of a tenant (docs/database-per-tenant.md): sslmode must be require, verify-ca or verify-full.
# TENANT_DB_URL_ACME=
