# PRODUCTION MODE. This template contains NO secret values.
#
# On servers/Kubernetes, supply these values through a ConfigMap + Secret or a secret manager,
# NOT through a file. .env.production is only for non-container deployments and must not be committed.
# Use a PASETO_KEY and DB_PASSWORD that are DIFFERENT from development.

APP_ENV=production
APP_PORT=8080
LOG_LEVEL=info

DB_HOST=
DB_PORT=5432
DB_USER=
# REQUIRED in production (the application refuses to start if empty)
DB_PASSWORD=
DB_NAME=
DB_SCHEMA=public
# require or verify-full. "disable" is rejected in production.
DB_SSLMODE=require

# REQUIRED. Generate with: make keygen
PASETO_KEY=
TOKEN_ISSUER=go-gin-tenant-template
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Example: app.example.com  -> tokoa.app.example.com is recognized as tenant "tokoa"
TENANT_BASE_DOMAIN=
TENANT_HEADER=X-Tenant-Code
